                },
                "required": [
                  "type",
                  "profileId"
                ],
                "additionalProperties": false
              }
            ],
            "discriminator": {
              "propertyName": "type"
            }
          },
          "model": {
            "type": "object",
            "properties": {
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
