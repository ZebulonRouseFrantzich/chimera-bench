          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "EnginesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
