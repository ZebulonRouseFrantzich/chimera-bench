                  "type": {
                    "type": "string",
                    "enum": [
                      "ssh"
                    ]
                  },
                  "profileId": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
