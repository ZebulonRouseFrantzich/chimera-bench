                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 64
              },
              "requestParams": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "validationMode": {
            "type": "string",
            "enum": [
              "strict",
              "permissive"
            ]
          },
          "timeouts": {
            "type": "object",
            "properties": {
              "caseMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 600000
