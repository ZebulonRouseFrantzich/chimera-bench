{
  "name": "chimera-bench",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "chimera-bench": "./bin/chimera-bench"
  },
  "scripts": {
    "serve": "bun run ./bin/chimera-bench serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "quality:check": "bun run ./scripts/check-source-quality.ts",
    "lint": "bun run typecheck && bun run quality:check",
    "release:build": "bun run ./scripts/build-release-artifacts.ts",
    "openapi:generate": "bun run ./scripts/generate-openapi.ts",
    "sdk:generate": "bun run ./scripts/generate-sdk.ts",
    "openapi:check": "bun run ./scripts/check-openapi-drift.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "bonjour-service": "^1.3.0",
    "hono": "^4.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
